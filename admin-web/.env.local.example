# Firebase web app config.
# Firebase console -> Project settings -> General -> Your apps -> Add app -> Web (</>)
# These values identify the project; they are not secrets. Access is enforced by Firestore rules.
# Copy this file to .env.local, fill it in, then restart `npm run dev`.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roktora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=roktora
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=roktora.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps JavaScript API key (enable Maps JavaScript API + Geocoding API; allow http://localhost:3000/* and your domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
